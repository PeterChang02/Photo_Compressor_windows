#include <windows.h>
1 ICON "AppIcon.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     @VER_COMMA@
 PRODUCTVERSION  @VER_COMMA@
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "PeterChang02"
      VALUE "FileDescription",  "Photo Compressor"
      VALUE "FileVersion",      "@VER@"
      VALUE "InternalName",     "PhotoCompressor"
      VALUE "LegalCopyright",   "MIT License"
      VALUE "OriginalFilename", "Photo Compressor.exe"
      VALUE "ProductName",      "Photo Compressor"
      VALUE "ProductVersion",   "@VER@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
